<?xml version="1.1" encoding="UTF-8"?>
<Theme xmlns="urn:tml:v1" name="downloads">
	<Color name="accent" for="the head line, the filled part of a bar, and a transfer that runs" light="#1e66f5" dark="#7aa2f7"/>
	<Color name="ok" for="a transfer that finished" light="#40a02b" dark="#9ece6a"/>
	<Color name="bad" for="a transfer that failed, and the head line after a failure" light="#d20f39" dark="#f7768e"/>
	<Color name="warn" for="the step line" light="#df8e1d" dark="#e0af68"/>
	<Color name="dim" for="text the eye can pass over" light="#6c6f85" dark="#565f89"/>
	<Color name="track" for="the part of a progress bar that is not filled" light="#ccd0da" dark="#3b4261"/>

	<Style name="head" bold="true" fg="{theme.accent}"/>
	<Style name="head.failed" bold="true" fg="{theme.bad}"/>
	<Style name="status" fg="{theme.warn}"/>
	<Style name="dim" faint="true" fg="{theme.dim}"/>
	<Style name="label.active" fg="{theme.accent}"/>
	<Style name="label.total" bold="true"/>
	<Style name="label.done" fg="{theme.ok}"/>
	<Style name="label.failed" fg="{theme.bad}"/>
</Theme>
