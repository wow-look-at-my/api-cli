<?xml version="1.1" encoding="UTF-8"?>
<Component xmlns="urn:tml:v1" name="Browse">
	<Import src="./theme.tml"/>

	<Property name="title" type="string" required="true"/>
	<Property name="hint" type="string" default=""/>
	<Property name="tree" type="string[]" default=""/>
	<Property name="selected" type="int" default="0"/>
	<Property name="filter" type="string" default=""/>
	<Property name="filtering" type="bool" default="false"/>

	<Property name="path" type="string" default=""/>
	<Property name="description" type="string" default=""/>
	<Property name="runnable" type="bool" default="false"/>
	<Property name="fields" type="record[]" default=""/>
	<Property name="line" type="string" default=""/>

	<Property name="running" type="bool" default="false"/>
	<Property name="status" type="string" default=""/>
	<Property name="statusStyle" type="string" default="dim"/>

	<!-- The result pane. The data view is a table; the text and raw views are lines. -->
	<Property name="paneTitle" type="string" default="Result"/>
	<Property name="views" type="string" default=""/>
	<Property name="isTable" type="bool" default="false"/>
	<Property name="columns" type="string[]" default=""/>
	<Property name="rows" type="string[]" default=""/>
	<Property name="rowSel" type="int" default="-1"/>
	<Property name="collapse" type="string[]" default=""/>
	<Property name="isText" type="bool" default="false"/>
	<Property name="output" type="string[]" default=""/>
	<Property name="empty" type="string" default=""/>
	<Property name="footer" type="string" default=""/>
	<Property name="rowFilter" type="string" default=""/>
	<Property name="rowFiltering" type="bool" default="false"/>

	<Property name="menu" type="bool" default="false"/>
	<Property name="menuTitle" type="string" default=""/>
	<Property name="menuItems" type="string[]" default=""/>
	<Property name="menuSel" type="int" default="0"/>
	<Property name="menuFilter" type="string" default=""/>

	<Property name="confirming" type="bool" default="false"/>
	<Property name="confirmText" type="string" default=""/>
	<Property name="help" type="bool" default="false"/>
	<Property name="helpLines" type="string[]" default=""/>

	<!-- One arg or flag of the selected command. A bool flag is a checkbox, everything else a text field. -->
	<DataTemplate name="Field">
		<Property name="id" type="string" required="true"/>
		<Property name="label" type="string" required="true"/>
		<Property name="hint" type="string" default=""/>
		<Property name="text" type="bool" default="true"/>
		<Property name="value" type="string" default=""/>
		<Property name="cursor" type="int" default="0"/>
		<Property name="checked" type="bool" default="false"/>
		<Template>
			<Grid columns="*[10..24],2*" gap="2">
				<Text Grid.column="0" style="label" overflow="ellipsis">{label}</Text>
				<Stack Grid.column="1" width="*">
					<Textbox id="{id}" if="{text}" value="{value}" cursor="{cursor}" placeholder="{hint}" width="*"/>
					<Checkbox id="{id}" if="{not text}" action="toggle:{id}" label="{hint}" checked="{checked}"/>
				</Stack>
			</Grid>
		</Template>
	</DataTemplate>

	<Template>
		<Canvas>
			<Stack gap="1">
				<Stack orientation="horizontal" gap="2">
					<Text style="head">{title}</Text>
					<Spinner kind="dots" color="{theme.accent}" if="{running}"/>
					<Spacer width="*"/>
					<Text style="dim" overflow="ellipsis">{hint}</Text>
				</Stack>

				<Grid columns="*[16..36],1*" rows="auto" gap="1">
					<Border title="Commands" color="{theme.track}" Grid.column="0">
						<Stack>
							<Textbox id="filter" if="{filtering}" value="{filter}" cursor="999" placeholder="filter" width="*"/>
							<List id="tree" items="{tree}" selected="{selected}"/>
						</Stack>
					</Border>

					<Border title="{path}" color="{theme.track}" Grid.column="1">
						<Stack gap="1" width="*">
							<Text style="dim" if="{description}">{description}</Text>
							<Stack itemsSource="{fields}" itemTemplate="Field" width="*" if="{runnable}"/>
							<Stack orientation="horizontal" gap="2" if="{runnable}">
								<Button id="run" action="run" label="Run" variant="primary"/>
								<Text style="dim" overflow="ellipsis">{line}</Text>
							</Stack>
						</Stack>
					</Border>
				</Grid>

				<Border id="pane" title="{paneTitle}" color="{theme.track}" width="*" height="*">
					<Stack width="*" height="*">
						<Stack orientation="horizontal" gap="2">
							<Text style="{statusStyle}" overflow="ellipsis">{status}</Text>
							<Spacer width="*"/>
							<Text style="label">{views}</Text>
						</Stack>
						<Textbox id="rowfilter" if="{rowFiltering}" value="{rowFilter}" cursor="999" placeholder="filter rows" width="*"/>
						<Stack height="*" width="*">
							<Table id="result" if="{isTable}" columns="{columns}" rows="{rows}" selected="{rowSel}" collapse="{collapse}" border="false" wrap="false" spacing="2" width="*"/>
							<List id="output" if="{isText}" items="{output}" selected="-1" cursor=" "/>
							<Text style="dim" if="{empty}">{empty}</Text>
						</Stack>
						<Text style="dim" overflow="ellipsis">{footer}</Text>
					</Stack>
				</Border>
			</Stack>

			<Popup title="{menuTitle}" color="{theme.accent}" if="{menu}">
				<Stack>
					<Text style="dim">{menuFilter}</Text>
					<List id="menu" items="{menuItems}" selected="{menuSel}"/>
				</Stack>
			</Popup>

			<Popup title="Confirm" color="{theme.warn}" if="{confirming}">
				<Stack gap="1">
					<Text>{confirmText}</Text>
					<Stack orientation="horizontal" gap="2">
						<Button id="confirm-yes" action="confirm" label="Run it" variant="danger"/>
						<Button id="confirm-no" action="cancel" label="Cancel"/>
					</Stack>
				</Stack>
			</Popup>

			<Popup title="Keys" color="{theme.accent}" if="{help}">
				<Stack>
					<For each="{helpLines}" as="row">
						<Text>{row}</Text>
					</For>
					<Text style="dim">any key closes this</Text>
				</Stack>
			</Popup>
		</Canvas>
	</Template>
</Component>
