<?xml version="1.1" encoding="UTF-8"?>
<Theme xmlns="urn:tml:v1" name="browse">
	<Color name="accent" for="the head line, the labels, the spinner, and the menu and the help" light="#1e66f5" dark="#7aa2f7"/>
	<Color name="ok" for="a run that worked" light="#40a02b" dark="#9ece6a"/>
	<Color name="bad" for="a run that failed" light="#d20f39" dark="#f7768e"/>
	<Color name="warn" for="the question before a command that asks to confirm" light="#df8e1d" dark="#e0af68"/>
	<Color name="dim" for="text the eye can pass over" light="#6c6f85" dark="#565f89"/>
	<Color name="track" for="the borders of the panes" light="#ccd0da" dark="#3b4261"/>

	<Style name="head" bold="true" fg="{theme.accent}"/>
	<Style name="label" fg="{theme.accent}"/>
	<Style name="dim" faint="true" fg="{theme.dim}"/>
	<Style name="ok" fg="{theme.ok}"/>
	<Style name="bad" bold="true" fg="{theme.bad}"/>
</Theme>
