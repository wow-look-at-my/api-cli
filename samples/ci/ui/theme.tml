<?xml version="1.1" encoding="UTF-8"?>
<Theme xmlns="urn:tml:v1" name="default">
	<Color name="accent" for="the border of a card, and a title" light="#2563eb" dark="#60a5fa"/>
	<Color name="dim" for="text the eye can pass over" light="#6b7280" dark="#9ca3af"/>
	<Color name="ok" for="a build that passed" light="#15803d" dark="#4ade80"/>
	<Color name="bad" for="a build that failed" light="#b91c1c" dark="#f87171"/>

	<Style name="card" border="rounded" borderColor="{theme.accent}" padding="0 1"/>
	<Style name="title" bold="true" fg="{theme.accent}"/>
	<Style name="muted" faint="true" fg="{theme.dim}"/>
	<Style name="log" faint="true"/>
	<Style name="ok" fg="{theme.ok}"/>
	<Style name="bad" fg="{theme.bad}"/>
</Theme>
